{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godotdndsimulator.local/schemas/v1/snapshot.schema.json",
  "title": "GodotDnDSimulator Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "session_id",
    "sequence",
    "tick",
    "counters"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "campaign_id": {"type": "string", "pattern": "^campaign:"},
    "session_id": {"type": "string", "pattern": "^session:"},
    "sequence": {"type": "integer", "minimum": 0},
    "tick": {"type": "integer", "minimum": 0},
    "counters": {
      "type": "object",
      "additionalProperties": {"type": "integer"}
    }
  }
}
