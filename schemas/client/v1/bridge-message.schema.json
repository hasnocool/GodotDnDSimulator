{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godotdndsimulator.local/schemas/client/v1/bridge-message.schema.json",
  "title": "GodotDnDSimulator Client Bridge Message v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "bridge_version",
    "kind",
    "request_id",
    "correlation_id",
    "generation",
    "payload"
  ],
  "properties": {
    "bridge_version": {"const": 1},
    "kind": {"type": "string", "minLength": 1},
    "request_id": {"type": "string"},
    "correlation_id": {"type": "string"},
    "generation": {"type": "integer", "minimum": 0},
    "ok": {"type": "boolean"},
    "payload": {"type": "object"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "user_message", "debug_detail"],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "none",
            "validation",
            "conflict",
            "unsupported",
            "incompatible_version",
            "transport",
            "timeout",
            "cancelled",
            "stale",
            "internal"
          ]
        },
        "user_message": {"type": "string"},
        "debug_detail": {"type": "string"}
      }
    }
  }
}
