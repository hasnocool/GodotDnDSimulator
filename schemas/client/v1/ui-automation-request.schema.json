{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godotdndsimulator.local/schemas/client/v1/ui-automation-request.schema.json",
  "title": "GodotDnDSimulator UI Automation Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "method", "params"],
  "properties": {
    "id": {"type": "string", "maxLength": 128},
    "token": {"type": "string", "maxLength": 512},
    "method": {
      "enum": [
        "automation.status",
        "ui.snapshot",
        "ui.inspect",
        "ui.focus",
        "ui.activate",
        "ui.click_at",
        "ui.set_text",
        "ui.input_action",
        "ui.logs",
        "ui.screenshot"
      ]
    },
    "params": {"type": "object"}
  }
}
